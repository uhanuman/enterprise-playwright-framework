{
  "name": "enterprise-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:bdd": "bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "security:scan": "tsx scripts/security-scan.ts",
    "quality:gate": "tsx scripts/quality-gate.ts",
    "generate:api-tests": "tsx scripts/generate-api-tests.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "date-fns": "^4.1.0",
    "fast-deep-equal": "^3.1.3",
    "fast-json-patch": "^3.1.1",
    "jsonpath-plus": "^10.3.0",
    "package.json": "^0.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.10.1",
    "lighthouse": "^12.3.0",
    "playwright-bdd": "^9.2.0",
    "playwright-lighthouse": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
